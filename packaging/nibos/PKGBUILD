# inkdot for nibOS (Arch Linux ARM, aarch64): a Game Boy and Game Boy Color emulator that
# DSlot starts for GB and GBC games.
#
# Built from this checkout, not downloaded: prepare() copies the sources into $srcdir, so the
# build never writes to the repository. Dependencies are fetched once, at the versions
# Cargo.lock pins, and the build itself runs offline. On an aarch64 Arch machine (nibOS's build
# machine):
#
#   cd packaging/nibos && PKGDEST="$PWD/out" BUILDDIR="$HOME/makepkg-build" makepkg -f --nodeps
#
# (--nodeps: the build machine needs Rust, a C compiler and SDL2, not what inkdot needs to run.)
#
# RetroAchievements is on (feature `cheevos`: rcheevos built in, `curl` at run time): DSlot's
# sign-in reaches inkdot through RA_TOKEN_FILE (DSlot's docs/retroachievements.md).

pkgname=inkdot
pkgver=0.1.0
pkgrel=10
pkgdesc="Game Boy and Game Boy Color emulator for the Anbernic RG DS+, started from DSlot"
arch=(aarch64)
url="https://github.com/abradburne/inkdot"
license=('MIT OR Apache-2.0')
depends=(sdl2-compat curl)   # curl: carries the requests to RetroAchievements
makedepends=(cargo gcc)   # gcc: rcheevos, the RetroAchievements client library
optdepends=('dslot: the game shelf that starts it')

_root=$(cd "$startdir/../.." && pwd)
# nibkit comes from its repository at the tag Cargo.toml names, unless NIBKIT names a local
# checkout to build against instead (patched in, as CONTRIBUTING.md describes).
_nibkit=${NIBKIT:+$(cd "$NIBKIT" && pwd)}

pkgver() {
    sed -n 's/^version = "\(.*\)"/\1/p' "$_root/Cargo.toml" | head -1
}

prepare() {
    rm -rf "$srcdir/inkdot" "$srcdir/nibkit"
    mkdir -p "$srcdir/inkdot/packaging/nibos"
    cp -r "$_root"/{Cargo.toml,Cargo.lock,crates,README.md,CHANGELOG.md,LICENSE-MIT,LICENSE-APACHE,LICENSE-OFL,THIRD-PARTY.md,docs} "$srcdir/inkdot/"
    # Installed for DSlot, and checked against the program's options by a test.
    cp "$_root/packaging/nibos/inkdot.toml" "$srcdir/inkdot/packaging/nibos/"
    # The build's own Cargo config, not the checkout's (which is each developer's): tuned for the
    # DS+'s Cortex-A55 cores.
    mkdir -p "$srcdir/inkdot/.cargo"
    printf '[target.aarch64-unknown-linux-gnu]\nrustflags = ["-C", "target-cpu=cortex-a55"]\n' \
        > "$srcdir/inkdot/.cargo/config.toml"
    local locked=--locked
    if [ -n "$_nibkit" ]; then
        mkdir -p "$srcdir/nibkit"
        cp -r "$_nibkit"/{Cargo.toml,build.rs,src,assets,examples,README.md,CHANGELOG.md,LICENSE} "$srcdir/nibkit/"
        printf '\n[patch."https://github.com/abradburne/nibkit"]\nnibkit = { path = "%s" }\n' \
            "$srcdir/nibkit" >> "$srcdir/inkdot/.cargo/config.toml"
        # Cargo.lock pins the tag's nibkit; the local one replaces it in the copy here.
        locked=
    fi
    cd "$srcdir/inkdot"
    cargo fetch $locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$srcdir/inkdot"
    cargo build --release --frozen -p inkdot --features dslot,cheevos
}

check() {
    cd "$srcdir/inkdot"
    # The test ROM suites skip here (the ROMs aren't part of the sources); make check runs them.
    cargo test --release --frozen -p inkdot-core -p inkdot -p inkdot-cheevos --features inkdot/dslot,inkdot/cheevos
}

package() {
    cd "$srcdir/inkdot"
    install -Dm755 target/release/inkdot "$pkgdir/usr/bin/inkdot"
    install -Dm644 packaging/nibos/inkdot.toml "$pkgdir/usr/share/dslot/emulators/inkdot.toml"
    install -Dm644 -t "$pkgdir/usr/share/doc/inkdot" README.md CHANGELOG.md docs/*.md
    install -Dm644 -t "$pkgdir/usr/share/licenses/inkdot" LICENSE-MIT LICENSE-APACHE THIRD-PARTY.md
    # rcheevos (MIT), built in for RetroAchievements: its notice goes with every copy.
    install -Dm644 crates/inkdot-cheevos/rcheevos/LICENSE "$pkgdir/usr/share/licenses/inkdot/LICENSE.rcheevos"
    # The Roboto Condensed fonts built in (through nibkit) are under the SIL OFL 1.1.
    install -Dm644 LICENSE-OFL "$pkgdir/usr/share/licenses/inkdot/OFL.txt"
}
