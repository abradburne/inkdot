# inkdot for nibOS (Arch Linux ARM, aarch64): a Game Boy and Game Boy Color emulator that
# DSlot starts for GB and GBC games.
#
# Built from this checkout, not downloaded: prepare() copies the sources into $srcdir, so the
# build never writes to the repository. Dependencies are fetched once, at the versions
# Cargo.lock pins, and the build itself runs offline. On an aarch64 Arch machine (nibOS's build
# machine):
#
#   cd packaging/nibos && PKGDEST="$PWD/out" BUILDDIR="$HOME/makepkg-build" makepkg -f --nodeps
#
# (--nodeps: the build machine needs Rust and SDL2, not what inkdot needs to run.)

pkgname=inkdot
pkgver=0.1.0
pkgrel=1
pkgdesc="Game Boy and Game Boy Color emulator for the Anbernic RG DS+, started from DSlot"
arch=(aarch64)
url="https://github.com/abradburne/inkdot"
license=('MIT OR Apache-2.0')
depends=(sdl2-compat)
makedepends=(cargo)
optdepends=('dslot: the game shelf that starts it')

_root=$(cd "$startdir/../.." && pwd)
# nibkit, the nibOS SDK's library: the nibOS repository beside this one.
_nibkit=$(cd "${NIBKIT:-$_root/../nibos/sdk/nibkit}" && pwd)

pkgver() {
    sed -n 's/^version = "\(.*\)"/\1/p' "$_root/Cargo.toml" | head -1
}

prepare() {
    rm -rf "$srcdir/inkdot" "$srcdir/nibos"
    mkdir -p "$srcdir/inkdot/packaging/nibos"
    cp -r "$_root"/{Cargo.toml,Cargo.lock,.cargo,crates,assets,README.md,CHANGELOG.md,LICENSE-MIT,LICENSE-APACHE,docs} "$srcdir/inkdot/"
    # Installed for DSlot, and checked against the program's options by a test.
    cp "$_root/packaging/nibos/inkdot.toml" "$srcdir/inkdot/packaging/nibos/"
    # Where Cargo.toml looks for it: ../nibos/sdk/nibkit.
    mkdir -p "$srcdir/nibos/sdk/nibkit"
    cp -r "$_nibkit"/{Cargo.toml,src,README.md,LICENSE} "$srcdir/nibos/sdk/nibkit/"
    cd "$srcdir/inkdot"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$srcdir/inkdot"
    cargo build --release --frozen -p inkdot --features dslot
}

check() {
    cd "$srcdir/inkdot"
    # The test ROM suites skip here (the ROMs aren't part of the sources); make check runs them.
    cargo test --release --frozen -p inkdot-core -p inkdot --features inkdot/dslot
}

package() {
    cd "$srcdir/inkdot"
    install -Dm755 target/release/inkdot "$pkgdir/usr/bin/inkdot"
    install -Dm644 packaging/nibos/inkdot.toml "$pkgdir/usr/share/dslot/emulators/inkdot.toml"
    install -Dm644 -t "$pkgdir/usr/share/doc/inkdot" README.md CHANGELOG.md docs/*.md
    install -Dm644 -t "$pkgdir/usr/share/licenses/inkdot" LICENSE-MIT LICENSE-APACHE
}
